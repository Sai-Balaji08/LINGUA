# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Supabase (Project Settings -> API) ---
# These two are PUBLIC by design. Row Level Security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The URL where the site runs. Used in email links (verification, password reset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI conversation partner (optional) ---
# SERVER ONLY. Never add NEXT_PUBLIC_ in front of these.
# Without a key, lessons, vocabulary and review all keep working and the AI features show a friendly "unavailable" message.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Maximum AI requests per learner per day. Controls cost; lessons are never limited.
AI_DAILY_LIMIT=40

# NOTE: LINGUA never needs the Supabase service-role key. Do not add it to this project.
